---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { getPosts } from '../lib/posts'
import { siteConfig } from '../site.config'

const posts = await getPosts()
---

<BaseLayout>
  <section class="home-hero">
    <p class="label-large muted">个人博客</p>
    <h1 class="display-small">{siteConfig.title}</h1>
    <p class="body-large muted home-hero__lede">{siteConfig.description}</p>
    <div class="home-hero__actions">
      <a class="btn btn--filled" href="/posts/">全部文章</a>
      <a class="btn btn--text" href="/search/">搜索</a>
    </div>
  </section>

  <section aria-labelledby="latest">
    <div class="section-head">
      <h2 id="latest" class="headline-medium section-head__title">最近更新</h2>
      <a class="section-head__link" href="/archive/">归档</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="post-grid">
          {posts.slice(0, 6).map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-state body-large">还没有文章，去写第一篇吧。</div>
      )
    }
  </section>
</BaseLayout>
