---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Comments from '../../components/Comments.astro'
import Toc from '../../components/Toc.astro'
import { formatDate, getPosts, isoDate, postUrl, readingMinutes, tagUrl } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const posts = await getPosts()
const index = posts.findIndex((item) => item.id === post.id)
const newer = index > 0 ? posts[index - 1] : undefined
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined

const { title, description, date, updated, tags } = post.data
---

<BaseLayout title={title} description={description} ogType="article">
  <div class="article-layout">
    <div class="post-article">
      <header class="post-header">
        <h1 class="headline-large post-header__title">{title}</h1>
        <div class="post-header__meta body-small">
          <span>
            <time datetime={isoDate(date)}>{formatDate(date)}</time>
          </span>
          <span>约 {readingMinutes(post.body)} 分钟</span>
          {updated && <span>更新于 {formatDate(updated)}</span>}
        </div>

        {
          tags.length > 0 && (
            <ul class="chip-row post-header__tags" aria-label="标签">
              {tags.map((tag) => (
                <li>
                  <a class="chip" href={tagUrl(tag)}>{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="prose" data-pagefind-body>
        <Content />
      </div>

      <nav class="prev-next" aria-label="相邻文章">
        {
          older ? (
            <a href={postUrl(older)}>
              <span class="prev-next__label label-small">上一篇（更早）</span>
              <span class="prev-next__title title-medium">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer ? (
            <a class="prev-next__next" href={postUrl(newer)}>
              <span class="prev-next__label label-small">下一篇（更新）</span>
              <span class="prev-next__title title-medium">{newer.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>

      <Comments />
    </div>

    <Toc headings={headings} />
  </div>
</BaseLayout>
