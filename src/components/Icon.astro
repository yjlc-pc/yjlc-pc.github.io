---
import home from '../icons/home.svg?raw'
import article from '../icons/article.svg?raw'
import sell from '../icons/sell.svg?raw'
import info from '../icons/info.svg?raw'
import search from '../icons/search.svg?raw'
import lightMode from '../icons/light_mode.svg?raw'
import darkMode from '../icons/dark_mode.svg?raw'
import rssFeed from '../icons/rss_feed.svg?raw'
import arrowBack from '../icons/arrow_back.svg?raw'
import arrowForward from '../icons/arrow_forward.svg?raw'
import openInNew from '../icons/open_in_new.svg?raw'
import link from '../icons/link.svg?raw'

const icons = {
  home,
  article,
  tag: sell,
  info,
  search,
  light: lightMode,
  dark: darkMode,
  rss: rssFeed,
  back: arrowBack,
  forward: arrowForward,
  external: openInNew,
  link,
} as const

export type IconName = keyof typeof icons

interface Props {
  name: IconName
  class?: string
}

const { name, class: className } = Astro.props
---

<span class:list={['icon', className]} aria-hidden="true">
  <Fragment set:html={icons[name]} />
</span>
