---
import { siteConfig } from '../site.config'

const giscus = siteConfig.giscus
const enabled = Boolean(giscus.enabled && giscus.repoId && giscus.categoryId)
---

{
  enabled && (
    <section class="comments" id="comments">
      <h2 class="title-large">评论</h2>
      <div
        class="giscus"
        data-repo={giscus.repo}
        data-repo-id={giscus.repoId}
        data-category={giscus.category}
        data-category-id={giscus.categoryId}
        data-mapping={giscus.mapping}
        data-strict={giscus.strict}
        data-reactions-enabled={giscus.reactionsEnabled}
        data-emit-metadata="0"
        data-input-position={giscus.inputPosition}
        data-lang={giscus.lang}
        data-loading="lazy"
      />
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={giscus.repo}
        data-repo-id={giscus.repoId}
        data-category={giscus.category}
        data-category-id={giscus.categoryId}
        data-mapping={giscus.mapping}
        data-strict={giscus.strict}
        data-reactions-enabled={giscus.reactionsEnabled}
        data-emit-metadata="0"
        data-input-position={giscus.inputPosition}
        data-lang={giscus.lang}
        data-loading="lazy"
        data-theme="preferred_color_scheme"
        crossorigin="anonymous"
        async
      />
      <script is:inline>
        ;(() => {
          const send = (theme) => {
            const frame = document.querySelector('iframe.giscus-frame')
            if (!frame) return
            frame.contentWindow?.postMessage(
              { giscus: { setConfig: { theme } } },
              'https://giscus.app',
            )
          }
          document.addEventListener('themechange', (event) => {
            send(event.detail === 'dark' ? 'dark' : 'light')
          })
          window.addEventListener('message', (event) => {
            if (event.origin !== 'https://giscus.app') return
            if (event.data?.giscus?.discussion) {
              send(document.body.classList.contains('dark') ? 'dark' : 'light')
            }
          })
        })()
      </script>
    </section>
  )
}
