---
interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: Heading[]
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{
  items.length > 0 && (
    <aside class="article-toc" aria-label="本页目录">
      <div class="article-toc__inner">
        <p class="label-large article-toc__title">本页目录</p>
        <nav>
          <ul>
            {items.map((h) => (
              <li class:list={[h.depth === 3 && 'toc-h3']}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>
  )
}

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.article-toc a'),
  )
  if (links.length > 0) {
    const targets = links
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1))
        return document.getElementById(id)
      })
      .filter((el): el is HTMLElement => Boolean(el))

    const setActive = (id: string) => {
      for (const link of links) {
        link.classList.toggle(
          'is-active',
          decodeURIComponent(link.hash.slice(1)) === id,
        )
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (visible[0]) setActive(visible[0].target.id)
      },
      { rootMargin: '-80px 0px -70% 0px' },
    )

    for (const target of targets) observer.observe(target)
  }
</script>
